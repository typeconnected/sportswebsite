# MongoDB root credentials (used by the mongo container and the server's MONGO_URI)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_this_strong_password

# Your public app URL (used for CORS on the server)
CLIENT_URL=https://your-domain.com

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_min_64_chars
JWT_REFRESH_SECRET=change_this_min_64_chars_too
JWT_EXPIRE=15m
